# --- Assistant IA (TADASHI AI) -------------------------------------------
# Clé API Anthropic. Reste côté serveur, jamais envoyée au navigateur.
ANTHROPIC_API_KEY=
# Modèle utilisé par l'assistant et par l'extraction de documents.
LLM_MODEL=claude-opus-5-5
# low | medium | high — profondeur de raisonnement (coût / latence).
LLM_EFFORT=low
LLM_MAX_TOKENS=2000

# --- Administration (/admin) ----------------------------------------------
# Sans mot de passe, l'interface d'administration est désactivée.
ADMIN_PASSWORD=
# Chaîne aléatoire longue (openssl rand -hex 32) pour signer les sessions.
SESSION_SECRET=

# --- Site -------------------------------------------------------------------
# URL publique, utilisée pour le SEO (sitemap, Open Graph).
SITE_URL=http://localhost:3000
# Dossier des données modifiables (contenu, fichiers importés, messages).
DATA_DIR=./data
# Optionnel : URL appelée (POST JSON) à chaque message du formulaire de contact.
CONTACT_WEBHOOK_URL=
# Limites de l'assistant, par adresse IP.
CHAT_RATE_PER_MINUTE=8
CHAT_RATE_PER_DAY=60
