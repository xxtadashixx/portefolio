# --- Assistant IA (TADASHI AI) -------------------------------------------
# Clé gratuite : https://aistudio.google.com/apikey (Google AI Studio).
# Reste côté serveur, jamais envoyée au navigateur.
GEMINI_API_KEY=
# Modèle(s) Gemini, dans l'ordre d'essai, séparés par des virgules : si le premier est
# introuvable ou sans quota, le suivant est utilisé. Ils doivent être dans l'offre gratuite.
LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=2048

# --- Administration (/admin) ----------------------------------------------
# Sans mot de passe, l'interface d'administration est désactivée.
ADMIN_PASSWORD=
# Chaîne aléatoire longue (openssl rand -hex 32) pour signer les sessions.
SESSION_SECRET=

# --- Site -------------------------------------------------------------------
# URL publique, utilisée pour le SEO (sitemap, Open Graph).
SITE_URL=http://localhost:3000
# Dossier des données modifiables (contenu, fichiers importés, messages).
DATA_DIR=./data
# Optionnel : URL appelée (POST JSON) à chaque message du formulaire de contact.
CONTACT_WEBHOOK_URL=
# Limites de l'assistant (l'offre gratuite de Gemini a un quota par minute et par jour).
CHAT_RATE_PER_MINUTE=8
CHAT_RATE_PER_DAY=60
CHAT_RATE_GLOBAL_PER_MINUTE=10
